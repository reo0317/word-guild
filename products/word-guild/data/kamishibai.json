  "letters": {
    "1": [
      {
        "pic": "kami/letter-01/01",
        "text": "Some {say} the fog is a gift,"
      },
      {
        "pic": "kami/letter-01/02",
        "text": "but I {think} you {know} the truth."
      },
      {
        "pic": "kami/letter-01/03",
        "text": "It is {time} to {see} it."
      },
      {
        "pic": "kami/letter-01/04",
        "text": "Every {year}, {good} {people} {come} to {work} here."
      },
      {
        "pic": "kami/letter-01/05",
        "text": "Few of them stay through the winter."
      },
      {
        "pic": "kami/letter-01/06",
        "text": "{Use} the {new} bag and {look} at each name."
      },
      {
        "pic": "kami/letter-01/07",
        "text": "Some will not {want} their words, but {give} them anyway."
      },
      {
        "pic": "kami/letter-01/08",
        "text": "In a {day}, you will {find} a {way} to do it."
      },
      {
        "pic": "kami/letter-01/09",
        "text": "Furo and all you {need} are at the {back}."
      },
      {
        "pic": "kami/letter-01/10",
        "text": "If a {child} asks what the fog {means}, {tell} the truth."
      },
      {
        "pic": "kami/letter-01/11",
        "text": "{Last} rule: never {call} me about the bottom drawer."
      }
    ]
  }
